<Window x:Class="RyuuseiManager.WhiteCardEditorSF3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RyuuseiManager"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="400"
        Padding="15"
        Title="{DynamicResource Btn_ChangeWhiteCard}">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0">

        <!-- Grid 1: combo selector -->
        <Grid Grid.Row="0">
            <ComboBox x:Name="ComboList"
                      MinWidth="340" Height="26" FontSize="15"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      DisplayMemberPath="Text"
                      SelectedValuePath="Value"
                      SelectionChanged="ComboList_SelectionChanged"/>
        </Grid>

        <!-- Grid 2: white card icons -->
        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image x:Name="Card1Image" Grid.Row="0" Grid.Column="0" Width="216" Height="162" Margin="2"
                   Stretch="UniformToFill" SnapsToDevicePixels="True"/>
            <Image x:Name="Card2Image" Grid.Row="0" Grid.Column="1" Width="216" Height="162" Margin="2"
                   Stretch="UniformToFill" SnapsToDevicePixels="True"/>
            <Image x:Name="Card3Image" Grid.Row="1" Grid.Column="0" Width="216" Height="162" Margin="2"
                   Stretch="UniformToFill" SnapsToDevicePixels="True"/>
            <Image x:Name="Card4Image" Grid.Row="1" Grid.Column="1" Width="216" Height="162" Margin="2"
                   Stretch="UniformToFill" SnapsToDevicePixels="True"/>
        </Grid>

        <!-- Grid 3: OK / Cancel buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" Height="30"
                    Margin="0,10,0,0">

            <Button Content="{DynamicResource Btn_OK}"
                    Width="80" Height="26" FontSize="15"
                    IsDefault="True"
                    Click="Ok_Click"
                    Margin="2"/>

            <Button Content="{DynamicResource Btn_Cancel}"
                    Width="80" Height="26" FontSize="15"
                    IsCancel="True"
                    Margin="2"/>
        </StackPanel>

    </Grid>
</Window>
